[Unit]
Description=MyContacts API (Express)
After=network.target mongod.service

[Service]
Type=simple
User=azureuser
Group=azureuser
WorkingDirectory=/srv/mycontacts-api/current
EnvironmentFile=/etc/mycontacts-api.env
ExecStart=/usr/bin/node src/server.js
Restart=on-failure
RestartSec=5
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=full
ProtectHome=read-only
LimitNOFILE=65535
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
